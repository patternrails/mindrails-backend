# Copy to .env in the repository root. Use plain KEY=value lines without quotes.
# For an existing database, keep the current admin login, password and provider key.
MINDRAILS_ADMIN_LOGIN_ID=admin
MINDRAILS_ADMIN_PASSWORD=
MINDRAILS_PROVIDER_ENCRYPTION_KEY=
MINDRAILS_SECURE_COOKIE=false

MINDRAILS_MYSQL_URL=jdbc:mysql://mysql:3306/mindrails
MINDRAILS_MYSQL_USERNAME=mindrails_app
MINDRAILS_MYSQL_PASSWORD=
MINDRAILS_QDRANT_HOST=qdrant
MINDRAILS_QDRANT_PORT=6333
MINDRAILS_ERROR_LOG_FILE=./data/mindrails-error.log
MINDRAILS_FILE_STORAGE_DIRECTORY=./data

# Let Compose create and manage the database volumes for a fresh installation.
MINDRAILS_EXTERNAL_DB_VOLUMES=false

# Optional Compose working directory for existing absolute local asset paths.
# MINDRAILS_WORKSPACE_DIR=/absolute/path/to/mindrails
# Set to the host UID:GID if the file storage bind mount requires it.
# MINDRAILS_CONTAINER_USER=1000:1000
# MINDRAILS_MCP_ENCRYPTION_KEY=
